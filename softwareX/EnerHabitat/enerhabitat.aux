\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Mean-day result of Listing~2 for the joist-and-block roof in Cuernavaca, Mexico, in May (solar absorptance 0.3): outdoor air temperature ($T_a$), sol--air temperature ($T_{sa}$), and free-running indoor air temperature ($T_i$). At night $T_{sa}$ falls below $T_a$ owing to the long-wave radiation exchange with the sky; the shaded band is the adaptive comfort zone.}}{9}{figure.3}\protected@file@percent }
\newlabel{fig:slabresult}{{3}{9}{Mean-day result of Listing~2 for the joist-and-block roof in Cuernavaca, Mexico, in May (solar absorptance 0.3): outdoor air temperature ($T_a$), sol--air temperature ($T_{sa}$), and free-running indoor air temperature ($T_i$). At night $T_{sa}$ falls below $T_a$ owing to the long-wave radiation exchange with the sky; the shaded band is the adaptive comfort zone}{figure.3}{}}
